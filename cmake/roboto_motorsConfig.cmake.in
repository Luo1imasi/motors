@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(fmt)
find_dependency(spdlog)
find_dependency(Eigen3)
find_dependency(Boost COMPONENTS system)

include("${CMAKE_CURRENT_LIST_DIR}/roboto_motorsTargets.cmake")

if(NOT TARGET roboto_motors::roboto_motors)
    add_library(roboto_motors::roboto_motors INTERFACE IMPORTED)
    target_link_libraries(roboto_motors::roboto_motors INTERFACE 
        roboto_motors::motors
        roboto_motors::dm_motors
        roboto_motors::evo_motors
        roboto_motors::lro_motors
        roboto_motors::xyn_motors
        roboto_motors::motors_can
        roboto_motors::motors_canfd
    )
endif()

check_required_components(roboto_motors)
